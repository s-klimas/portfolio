    "class_name": "UserController",
    "class_type": "controller",
    "class_annotations": ["@AllArgsConstructor", "@RestController", "@RequestMapping(\"/users\")", "@Tag(name = \"Users\")"],
    "method_name": "registerUser",
    "http_method": "POST",
    "http_path": "/users",
    "method_annotations": ["@PostMapping", "@Operation(summary = \"Registers a user.\")"],
    "parameters": [
      { "name": "requestDto", "type": "RegisterUserRequestDto", "annotation": "@Valid @RequestBody" },
      { "name": "uriBuilder", "type": "UriComponentsBuilder", "annotation": null }
    ],
    "return_type": "ResponseEntity<RegisterUserResponseDto>",
    "throws": [],
    "description": "Endpoint rejestruje nowego użytkownika na podstawie przesłanych danych rejestracyjnych. Buduje adres URI nowo utworzonego zasobu użytkownika i zwraca odpowiedź HTTP 201 Created z lokalizacją zasobu oraz danymi zarejestrowanego użytkownika.",
    "code_snippet": "@PostMapping\n@Operation(summary = \"Registers a user.\")\npublic ResponseEntity<RegisterUserResponseDto> registerUser(\n        @Parameter(description = \"The new users data.\")\n        @Valid @RequestBody RegisterUserRequestDto requestDto,\n        UriComponentsBuilder uriBuilder) {\n    RegisterUserResponseDto userDto = userService.registerUser(requestDto);\n    var uri = uriBuilder.path(\"/users/{id}\").buildAndExpand(userDto.getId()).toUri();\n    return ResponseEntity.created(uri).body(userDto);\n}",
    "dependencies": ["UserService", "RegisterUserRequestDto", "RegisterUserResponseDto", "UriComponentsBuilder"],
    "tags": ["user", "registration", "create", "endpoint"],
    "source_type": "endpoint"
  },
